{
  "atomCode": "maven",
  "name": "Maven",
  "version": "1.3.0",
  "description": "把 maven-plugin 变成一个原子：action=build 跑 mvn goals，退出码即构建结果；action=resolve 按 GAV 从 Maven 仓库下载构件到工作区（仓库布局、RELEASE/LATEST/SNAPSHOT、校验和策略、Basic 凭据）。",
  "execution": {
    "packagePath": "maven.jar",
    "language": "java",
    "target": "$atom_java_path -cp maven.jar com.jenkinschina.atom.sdk.AtomRunner"
  },
  "input": {
    "action": {
      "label": "操作",
      "type": "select",
      "default": "build",
      "options": [
        {
          "label": "构建（build）：跑 mvn goals",
          "value": "build"
        },
        {
          "label": "解析构件（resolve）：按坐标下载到工作区",
          "value": "resolve"
        }
      ],
      "description": "build 在工作区里跑 mvn，退出码即结果；resolve 只下载构件，不跑 mvn。"
    },
    "goals": {
      "label": "goals（如 clean verify）",
      "type": "vuex-input",
      "default": "verify",
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "action",
            "value": "build"
          }
        ]
      }
    },
    "options": {
      "label": "额外参数（如 -DskipTests -Pci）",
      "type": "vuex-input",
      "default": "",
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "action",
            "value": "build"
          }
        ]
      }
    },
    "home": {
      "label": "mvn 安装目录（留空则用 PATH 或 $MAVEN_HOME）",
      "type": "vuex-input",
      "default": "",
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "action",
            "value": "build"
          }
        ]
      }
    },
    "repoUrl": {
      "label": "仓库地址（如 https://repo1.maven.org/maven2 或 Nexus 的 /repository/releases）",
      "type": "vuex-input",
      "default": "",
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "action",
            "value": "resolve"
          }
        ]
      }
    },
    "coordinates": {
      "label": "坐标，每行一个 groupId:artifactId:version[:extension[:classifier]]（版本可写 RELEASE / LATEST）",
      "type": "textarea",
      "default": "",
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "action",
            "value": "resolve"
          }
        ]
      }
    },
    "username": {
      "label": "用户名（可选；留空则用绑定的同名凭据）",
      "type": "vuex-input",
      "default": "",
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "action",
            "value": "resolve"
          }
        ]
      }
    },
    "password": {
      "label": "密码 / API Key（可选；留空则用绑定的同名凭据）",
      "type": "password",
      "default": "",
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "action",
            "value": "resolve"
          }
        ]
      }
    },
    "localRepository": {
      "label": "本地仓库目录（相对工作区，或绝对路径 / ~/.m2/repository）",
      "type": "vuex-input",
      "default": ".m2/repository",
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "action",
            "value": "resolve"
          }
        ]
      }
    },
    "targetDirectory": {
      "label": "复制到工作区的目标目录（留空即工作区根）",
      "type": "vuex-input",
      "default": "",
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "action",
            "value": "resolve"
          }
        ]
      }
    },
    "targetFileName": {
      "label": "复制后的文件名（单个坐标时可用，可带子目录）",
      "type": "vuex-input",
      "default": "",
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "action",
            "value": "resolve"
          }
        ]
      }
    },
    "checksumPolicy": {
      "label": "校验和策略（fail：不一致或缺失即失败；warn：只告警；ignore：不查）",
      "type": "selector",
      "default": "fail",
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "action",
            "value": "resolve"
          }
        ]
      },
      "options": [
        "fail",
        "warn",
        "ignore"
      ]
    },
    "timeoutSeconds": {
      "label": "单次请求超时（秒）",
      "type": "vuex-input",
      "default": "60",
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "action",
            "value": "resolve"
          }
        ]
      }
    },
    "failOnError": {
      "label": "失败即让这一步失败（build：mvn 非零退出码；resolve：任一构件解析失败）",
      "type": "checkbox",
      "default": "true"
    }
  },
  "output": {
    "exitCode": {
      "type": "string",
      "description": "build：mvn 的退出码"
    },
    "durationMs": {
      "type": "string",
      "description": "build：耗时（毫秒）"
    },
    "resolved": {
      "type": "string",
      "description": "resolve：成功解析的构件数"
    },
    "failed": {
      "type": "string",
      "description": "resolve：失败的构件数（failOnError=false 时才可能非零）"
    },
    "snapshots": {
      "type": "string",
      "description": "resolve：其中快照版本的数量"
    },
    "bytes": {
      "type": "string",
      "description": "resolve：下载的字节数"
    },
    "files": {
      "type": "string",
      "description": "resolve：本地仓库中的绝对路径，每行一个"
    },
    "targets": {
      "type": "string",
      "description": "resolve：工作区中的副本路径，每行一个"
    },
    "urls": {
      "type": "string",
      "description": "resolve：实际下载的远端 URL，每行一个"
    },
    "versions": {
      "type": "string",
      "description": "resolve：groupId:artifactId=实际版本（RELEASE/LATEST 解析后）"
    },
    "checksums": {
      "type": "string",
      "description": "resolve：每个构件一行：<路径>\\t<算法>=<ok|mismatch|missing|ignored>"
    },
    "first": {
      "type": "string",
      "description": "resolve：第一个工作区副本的路径"
    },
    "errors": {
      "type": "string",
      "description": "resolve：failOnError=false 时每个失败一行"
    }
  },
  "x-jenkins": {
    "protocol": "jenkins-1",
    "requires": {
      "runner": ">=0.4.0"
    },
    "secrets": {
      "username": "",
      "password": ""
    },
    "errors": {
      "40001": "入参有误：resolve 的坐标语法 / 用户名密码不配对 / checksumPolicy 未知；或 build 时 mvn 起不来",
      "40002": "resolve：repoUrl 缺失或不是 http(s) 地址",
      "40003": "resolve：构件在仓库里不存在（HTTP 404），消息里带 URL",
      "40004": "resolve：仓库拒绝凭据（HTTP 401/403），检查 username/password 或绑定的凭据",
      "40005": "resolve：仓库没有发布任何校验和，而 checksumPolicy=fail",
      "40006": "resolve：校验和与下载到的字节不符，而 checksumPolicy=fail；如需保留字节设 warn",
      "40007": "resolve：maven-metadata.xml 缺失、无法解析或没有可用版本",
      "40008": "resolve：其他 HTTP 错误、连接失败、短读或重定向异常",
      "40009": "resolve：targetFileName 只适用于单个坐标",
      "40010": "resolve：目标路径跑出了工作区",
      "40012": "resolve：落盘后回读的 SHA-1 与下载字节不符（磁盘或插件问题）",
      "40013": "resolve：请求超时；加大 timeoutSeconds",
      "40014": "action 不认识；用 build 或 resolve"
    },
    "category": "build"
  }
}
